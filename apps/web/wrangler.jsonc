{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The Workers preview. textile.cx gets its own environment, with its route, when Mia puts the site live.
  "name": "textile-web-preview",
  // Not later than the workerd bundled with the pinned wrangler.
  "compatibility_date": "2026-10-01",
  "main": ".svelte-kit/cloudflare/_worker.js",
  // The build copies the docs site (apps/docs) under /docs. Docs requests reach the Worker first
  // (src/routes/docs), so agents get Markdown there too.
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
    "run_worker_first": ["/docs", "/docs/*"]
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    // Textile's Discord application. Sign-in uses it with the `identify` scope.
    "DISCORD_CLIENT_ID": "1162037890742759424",
    "DISCORD_URL": "https://discord.com"
  },
  // Locally from .dev.vars (see .dev.vars.example); deployed, with `wrangler secret put`.
  "secrets": { "required": ["DISCORD_CLIENT_SECRET", "SESSION_KEY", "ACCESS_LIST"] }
}
